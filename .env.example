# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Base de datos ────────────────────────────────────────────────────
POSTGRES_USER=ventabot
POSTGRES_PASSWORD=ventabot_secret
POSTGRES_DB=ventabot_db
DATABASE_URL=postgresql+asyncpg://ventabot:ventabot_secret@db:5432/ventabot_db
DATABASE_URL_SYNC=postgresql://ventabot:ventabot_secret@db:5432/ventabot_db

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.3

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────
# Obtienes estos valores en: developers.facebook.com → tu app → WhatsApp
META_VERIFY_TOKEN=DEFINE_UN_TOKEN_ALEATORIO_AQUI
META_APP_SECRET=desde_meta_for_developers
WHATSAPP_API_VERSION=v19.0
# Estos son POR CLIENTE (cada negocio que onboardeas tiene los suyos)
# Se guardan en DB, no aquí. Solo para testing:
WA_TEST_PHONE_NUMBER_ID=
WA_TEST_ACCESS_TOKEN=

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=VentaBot

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
