# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=https://app.ventatalk.com
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Base de datos ────────────────────────────────────────────────────
POSTGRES_USER=ventatalk
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=ventatalk
DATABASE_URL=postgresql+asyncpg://ventatalk:your-db-password@db:5432/ventatalk
DATABASE_URL_SYNC=postgresql://ventatalk:your-db-password@db:5432/ventatalk

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.3

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────
META_VERIFY_TOKEN=your-verify-token
META_APP_SECRET=your-app-secret
WHATSAPP_API_VERSION=v19.0
WA_TEST_PHONE_NUMBER_ID=
WA_TEST_ACCESS_TOKEN=

# ── Widget ───────────────────────────────────────────────────────────
WIDGET_BUSINESS_ID=
WIDGET_ORIGIN=https://ventatalk.com

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=VentaTalk
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_ANNUAL=

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=
